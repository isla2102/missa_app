{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "observance": {
      "type": "string",
      "minLength": 1
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "reading",
              "gospel",
              "psalm",
              "acclamation",
              "prayer",
              "intercession",
              "preface",
              "antiphon"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "verified",
              "missing",
              "needs-review",
              "not-applicable"
            ]
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "text",
                    "priest",
                    "lector",
                    "assembly",
                    "guidance"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceRef": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "role",
                "text",
                "sourceRef"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "status",
          "paragraphs"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not-applicable"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "title": {
                  "const": "제2독서"
                },
                "kind": {
                  "const": "reading"
                },
                "paragraphs": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "documentId",
    "date",
    "observance",
    "sourceRefs",
    "sections"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
