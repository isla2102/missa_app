 .reader__item--score.reader__item--guided-score { grid-template-rows: auto auto minmax(0, 1fr); }
 .reader__item--compact-score { max-block-size: calc(100cqh - (2 * var(--draft-padding)) - 2px); min-block-size: 0; display: flex; flex-direction: column; }
 .reader__content-card--compact { min-block-size: 0; overflow: auto; }
 .reader__score-scroll { block-size: auto; min-block-size: 0; flex: 1; overflow: auto; overscroll-behavior: contain; }
 .reader__item--score { block-size: calc(100cqh - (2 * var(--draft-padding)) - 2px); min-block-size: 0; display: grid; grid-template-rows: auto minmax(0, 1fr); gap: var(--draft-toc-gap); }
 .reader__content-card--score { min-block-size: 0; display: flex; flex-direction: column; }
 .reader__prayer-option { display: flex; flex-wrap: wrap; gap: var(--draft-toc-gap); margin-block-end: var(--draft-toc-gap); }
