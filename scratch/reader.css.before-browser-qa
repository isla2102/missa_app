 .reader__score-enlarge { position: absolute; inset-block-start: var(--draft-toc-gap); inset-inline-end: var(--draft-toc-gap); z-index: var(--draft-score-action-z); font-size: var(--draft-score-action-font); padding: var(--draft-score-action-padding); min-block-size: var(--draft-score-action-hit); }
