
@layer tokens, base, layout, components, responsive, utilities;
@layer tokens {
 :root { --draft-reading-note-z: 2; --draft-reading-note-size: .875rem; --draft-header-gap: .375rem; --draft-brand-size: 1.5rem; --draft-preview-portrait-width: 48rem; --draft-preview-portrait-height: 64rem; --draft-preview-landscape-width: 64rem; --draft-preview-landscape-height: 48rem; --draft-dialogue-width: 12rem; --draft-score-action-z: 2; --draft-score-action-font: 0.75rem; --draft-score-action-padding: 0.25rem; --draft-score-action-hit: 1.5rem; --draft-modal-width: 90rem; --draft-modal-height: 92dvh; --draft-marker-width: 1.25rem; --draft-marker-gap: .375rem; --draft-choice-card-z: 0; --draft-choice-marker-z: 1; --draft-choice-marker-space: 1.25rem; --draft-guide-ink: #244b66; --draft-guide-surface: #eef4f8; --draft-response-weight: 700; --draft-response-border: 2px; --draft-toc-target: 1.5rem; --draft-toc-gap: .125rem; --draft-rail-max: 16rem; --draft-score-height: 3rem; --draft-item-gap: .75rem; --draft-content-inset: .625rem; --draft-gap: .75rem; --draft-padding: 1rem; --draft-panel: 28rem; --draft-target: 2.75rem; --focus-ring: 3px solid currentColor; }
